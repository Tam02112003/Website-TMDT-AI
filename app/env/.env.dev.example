ENV=dev

# Database (Postgres - e.g. Neon, Render, or local)
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_MAX_POOL_SIZE=5
DB_MIN_POOL_SIZE=1

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# JWT
JWT_SECRET=

# RapidAPI
RAPID_API_KEY=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# AWS (SNS topics + SQS queue for event streaming)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SNS_USER_ACTIVITY_TOPIC_ARN=
AWS_SNS_ORDER_EVENTS_TOPIC_ARN=
AWS_SNS_AUTH_EVENTS_TOPIC_ARN=
AWS_SNS_DISCOUNT_EVENTS_TOPIC_ARN=
AWS_SNS_NEWS_EVENTS_TOPIC_ARN=
AWS_SNS_PRODUCT_EVENTS_TOPIC_ARN=
AWS_SQS_USER_ACTIVITY_QUEUE_URL=

# Sepay (Vietnamese payment gateway)
SEPAY_API_TOKEN=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMS / Twilio
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_SENDER_ID=

# Local LLM (OpenAI-compatible; works with Groq, LM Studio, Ollama, etc.)
LOCAL_LLM_API_URL=http://localhost:11434
LOCAL_LLM_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend
FRONTEND_URL=http://localhost:5173

# SendGrid
SENDGRID_API_KEY=unused-placeholder

# Resend (actual email sender used by core/email_sender.py)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Your Shop Name <onboarding@resend.dev>
